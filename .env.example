# ── Notifications ──────────────────────────────────────────
# Discord webhook URL for job alerts
# How to get one: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# ── Semantic Matcher ────────────────────────────────────────
# Switch between "local" (all-mpnet-base-v2, free, offline)
# and "openai" (text-embedding-3-small, needs API key, better quality)
MATCHER_BACKEND=local

# Required only when MATCHER_BACKEND=openai
OPENAI_API_KEY=sk-...

# ── Monitor settings ────────────────────────────────────────
# How often to check for new jobs (in hours)
SCRAPE_INTERVAL_HOURS=3

# Minimum semantic similarity score to surface a job (0.0 to 1.0)
# 0.30 = broader net, 0.45 = tighter match
MATCH_THRESHOLD=0.30
